---
import Base from '../layouts/Base.astro';
import JournalDetails from '../components/JournalDetails.astro';
import { getCollection } from 'astro:content';
import { site, mail, issnLine, issueLabel, byOrder, fullJournalName, submitUrl, submitIsExternal } from '../lib/site';

const sections = (await getCollection('sections')).sort(byOrder);
const issues = (await getCollection('issues')).sort(byOrder);
const currentIssue = issues.find((i) => i.id === site.currentIssueSlug) ?? issues[0];
const articles = (await getCollection('articles')).sort(byOrder);
const currentArticles = currentIssue ? articles.filter((a) => a.data.issue === currentIssue.id) : [];
const announcements = (await getCollection('announcements')).sort(
  (a, b) => Number(b.data.pinned) - Number(a.data.pinned) || (new Date(`${b.data.date} UTC`).getTime() || 0) - (new Date(`${a.data.date} UTC`).getTime() || 0),
);
const board = (await getCollection('board')).sort(byOrder);
const leadership = board.filter((m) => m.data.roleGroup === 'Editorial Leadership');
const countries = new Set(board.map((m) => m.data.country).filter(Boolean));
const stats = [
  { value: site.issnOnline || '—', label: 'ISSN (Online)' },
  { value: String(currentArticles.length), label: `peer-reviewed articles in the current issue` },
  { value: String(board.length), label: 'editorial board members' },
  { value: String(countries.size), label: 'countries on the editorial board' },
  { value: '7', label: 'working days to a first written reply' },
];
---

<Base
  title="Home"
  fullTitle={`International Research Insights: Peer-Reviewed Multidisciplinary e-Journal | ISSN ${site.issnOnline}`}
  description={`Peer-reviewed, open access multidisciplinary journal (ISSN ${site.issnOnline}) publishing research in law, health and nursing, Hindi, history, education, policy and science. Submit your paper.`}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow eyebrow-rule"><span><span class="hide-sm">International Research Insights · </span>{issnLine()}</span></p>
        <h1 class="hero-title">A Peer-Reviewed, Open Access Multidisciplinary Journal</h1>
        <p class="lede">
          {fullJournalName} (ISSN (Online) {site.issnOnline}) is a peer-reviewed, open access journal publishing
          research in law, health sciences, humanities, education and public policy, in English and Hindi.
        </p>
        <p class="hero-tagline">Bridging scholarship and society, one issue at a time.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={submitUrl} target={submitIsExternal ? '_blank' : undefined} rel={submitIsExternal ? 'noopener' : undefined}>Submit a manuscript</a>
          <a class="btn btn-ghost" href="/current">Read the current issue</a>
        </div>
      </div>
      {currentIssue && (
        <a class="feature-card" href="/current">
          {currentIssue.data.cover && (
            <img src={currentIssue.data.cover.replace('cover-thumb', 'cover')} alt={`Cover of ${issueLabel(currentIssue.data)}`} width="600" height="849" />
          )}
          <p class="feature-kicker">Current issue · {issueLabel(currentIssue.data)}</p>
          <p class="feature-title">{currentIssue.data.editorialTitle}</p>
          <p class="feature-text">{currentIssue.data.summary}</p>
        </a>
      )}
    </div>
  </section>

  <section class="band about-band">
    <div class="wrap about-grid">
      <div>
        <p class="eyebrow eyebrow-rule eyebrow-dark">Who we are</p>
        <h2 class="about-title">About the Journal</h2>
      </div>
      <div class="about-text">
        <p>
          {fullJournalName} is an independent, peer-reviewed journal published online four times a year. It
          publishes original research articles, review articles, case comments, short communications and book reviews
          in English and Hindi across seven research sections.
        </p>
        <p>
          Every manuscript that passes editorial screening is read by two reviewers under double anonymous peer review,
          and every author receives a written response. A single standard of review applies to every discipline the
          journal covers.
        </p>
        <a class="text-link" href="/about">Read more about the journal</a>
      </div>
    </div>
    <div class="wrap pillars">
      <div class="pillar pillar-1" id="vision"><p class="pillar-head"><span>01</span>Vision</p><p>A research culture in which careful work from every kind of institution is reviewed fairly, published openly and read widely.</p></div>
      <div class="pillar pillar-2" id="mission"><p class="pillar-head"><span>02</span>Mission</p><p>To publish peer-reviewed scholarship in law, health, humanities, education and public policy, in English and Hindi, with a written response to every author and one standard of review.</p></div>
      <div class="pillar pillar-3"><p class="pillar-head"><span>03</span>We stand for</p><p>Rigour in method, fairness in review, transparency in policy, and research that is open to every reader.</p></div>
    </div>
  </section>

  <section class="stats-band" aria-label="The journal at a glance">
    <div class="wrap stats">
      {stats.map((item) => (
        <div class="stat"><span class="stat-value">{item.value}</span><span class="stat-label">{item.label}</span></div>
      ))}
    </div>
  </section>

  <JournalDetails />

  {currentIssue && (
    <section class="band band-tint">
      <div class="wrap">
        <div class="section-head">
          <h2>Current issue</h2>
          <a href="/archives">All issues</a>
        </div>
        <div class="layout-split">
          <div>
            <p class="meta">{issueLabel(currentIssue.data)}</p>
            <h3 style="font-size:1.5rem;margin-top:0.5rem">{currentIssue.data.editorialTitle}</h3>
            <p>{currentIssue.data.summary}</p>
            <p>
              <a class="btn btn-outline" href="/current">Open the current issue</a>
            </p>
            {currentArticles.length > 0 && (
              <ul class="toc" style="margin-top:2rem">
                {currentArticles.slice(0, 5).map((article) => (
                  <li>
                    <span class="badge">{article.data.articleType}</span>
                    <h3><a href={`/articles/${article.id}`}>{article.data.title}</a></h3>
                    <p class="authors">{article.data.authors.join(', ')}</p>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <aside class="sidebar">
            <h2>Issue status</h2>
            <dl>
              <dt>Stage</dt>
              <dd>{currentIssue.data.status}</dd>
              {currentIssue.data.submissionDeadline && (
                <>
                  <dt>Submission deadline</dt>
                  <dd>{currentIssue.data.submissionDeadline}</dd>
                </>
              )}
              {currentIssue.data.publicationDate && (
                <>
                  <dt>Publication date</dt>
                  <dd>{currentIssue.data.publicationDate}</dd>
                </>
              )}
              <dt>Manuscripts to</dt>
              <dd><a href={`mailto:${mail('submissions')}`}>{mail('submissions')}</a></dd>
            </dl>
          </aside>
        </div>
      </div>
    </section>
  )}

  <section class="band">
    <div class="wrap research-grid">
      <div>
        <h2 class="about-title">Research</h2>
        <p class="research-intro">Seven research sections, one standard of review: evidence first, open about its assumptions, written for the people who decide.</p>
        <a class="text-link" href="/sections">Overview</a>
      </div>
      <div>
        <p class="mega-kicker">Research sections</p>
        <ol class="numbered">
          {sections.map((section, index) => (
            <li><a href={`/sections/${section.id}`}><span class="num">{String(index + 1).padStart(2, '0')}</span>{section.data.title}</a></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="band band-tint">
    <div class="wrap">
      <div class="layout-split">
        <div>
          <div class="section-head">
            <h2>Announcements</h2>
            <a href="/announcements">All announcements</a>
          </div>
          <ul class="toc">
            {announcements.slice(0, 4).map((item) => (
              <li>
                <p class="meta">{item.data.date}{item.data.pinned ? ' · Pinned' : ''}</p>
                <h3><a href={`/announcements/${item.id}`}>{item.data.title}</a></h3>
                <p>{item.data.summary}</p>
              </li>
            ))}
          </ul>
        </div>
        <aside class="sidebar">
          <h2>Editorial leadership</h2>
          <ul>
            {leadership.map((member) => (
              <li>
                <a href="/editorial-board">
                  {member.data.name}
                  <br />
                  <span class="meta">{member.data.role}</span>
                </a>
              </li>
            ))}
          </ul>
          <p style="margin-top:1rem"><a class="btn btn-outline" href="/editorial-board">Full editorial board</a></p>
        </aside>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <h2>Three stages, each with a written outcome</h2>
        <a href="/peer-review-policy">Peer review policy</a>
      </div>
      <div class="grid grid-3">
        <article class="card">
          <p class="eyebrow">Stage one</p>
          <h3>Editorial screening</h3>
          <p>
            Every manuscript is checked within seven working days for scope, structure, referencing and similarity.
            Authors receive a written decision at this stage, never silence.
          </p>
          <a class="card-link" href="/submission-guidelines">Preparation checklist</a>
        </article>
        <article class="card">
          <p class="eyebrow">Stage two</p>
          <h3>Double anonymous review</h3>
          <p>
            Two reviewers assess the anonymised manuscript against a published rubric covering originality, method,
            evidence, argument and referencing. Reports reach the author with the decision.
          </p>
          <a class="card-link" href="/peer-review-policy">Review criteria</a>
        </article>
        <article class="card">
          <p class="eyebrow">Stage three</p>
          <h3>Publication and archiving</h3>
          <p>
            Accepted work is copy edited, proofed with the author, published under {site.licence} and deposited in the
            journal archive within the issue cycle.
          </p>
          <a class="card-link" href="/indexing-and-preservation">Preservation policy</a>
        </article>
      </div>
    </div>
  </section>
  <section class="cta-band">
    <div class="wrap cta">
      <div>
        <p class="eyebrow">Call for papers</p>
        <h2>Last date of submission: 30 November 2026</h2>
        <p>Processing charges are payable only after acceptance. Nothing is charged at submission or if a paper is not accepted.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={submitUrl} target={submitIsExternal ? '_blank' : undefined} rel={submitIsExternal ? 'noopener' : undefined}>Submit a manuscript</a>
        <a class="btn btn-ghost" href="/processing-charges">Processing charges</a>
      </div>
    </div>
  </section>
</Base>
