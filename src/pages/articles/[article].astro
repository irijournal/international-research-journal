---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection, render } from 'astro:content';
import { site, mail, issnLine, issueLabel, fullJournalName, snippet } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const issues = await getCollection('issues');
  return articles.map((article) => ({
    params: { article: article.id },
    props: { article, issue: issues.find((i) => i.id === article.data.issue) },
  }));
}

const { article, issue } = Astro.props;
const { Content } = await render(article);
const year = issue?.data.year ?? new Date().getFullYear();
const names = article.data.authors;
const authorLine = names.length > 1 ? `${names.slice(0, -1).join(', ')} & ${names[names.length - 1]}` : names[0];
const pageUrl = new URL(`/articles/${article.id}`, Astro.site).toString();
const citation = `${authorLine} (${year}). ${article.data.title}. ${fullJournalName}${issue ? `, ${issueLabel(issue.data)}` : ''}${article.data.pageRange ? `, pp. ${article.data.pageRange}` : ''}. ${article.data.doi ? `https://doi.org/${article.data.doi}` : pageUrl}`;
const [firstPage, lastPage] = (article.data.pageRange ?? '').split(/\s*(?:–|-|to)\s*/);
const published = article.data.publishedDate ? new Date(`${article.data.publishedDate} UTC`) : null;
const citationDate = published && !Number.isNaN(published.getTime())
  ? `${published.getUTCFullYear()}/${String(published.getUTCMonth() + 1).padStart(2, '0')}/${String(published.getUTCDate()).padStart(2, '0')}`
  : String(year);
const abstractParagraphs = article.data.abstract.split(/\n\s*\n/);
const home = new URL('/', Astro.site).toString();
const isoDate = published && !Number.isNaN(published.getTime()) ? published.toISOString().slice(0, 10) : String(year);
const articleLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ScholarlyArticle',
      '@id': `${pageUrl}#article`,
      headline: article.data.title.slice(0, 110),
      name: article.data.title,
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      abstract: article.data.abstract,
      keywords: article.data.keywords.join(', '),
      author: article.data.authors.map((name, index) => ({
        '@type': 'Person',
        name,
        ...(article.data.affiliations?.[index] ? { affiliation: { '@type': 'Organization', name: article.data.affiliations[index] } } : {}),
      })),
      datePublished: isoDate,
      inLanguage: 'en',
      genre: article.data.articleType,
      articleSection: article.data.section,
      isAccessibleForFree: true,
      license: 'https://creativecommons.org/licenses/by/4.0/',
      publisher: { '@id': `${home}#publisher` },
      ...(firstPage ? { pageStart: firstPage } : {}),
      ...(lastPage ? { pageEnd: lastPage } : {}),
      ...(article.data.pdf ? { encoding: { '@type': 'MediaObject', contentUrl: new URL(article.data.pdf, Astro.site).toString(), encodingFormat: 'application/pdf' } } : {}),
      ...(article.data.doi ? { sameAs: `https://doi.org/${article.data.doi}` } : {}),
      ...(issue
        ? {
            isPartOf: {
              '@type': 'PublicationIssue',
              issueNumber: String(issue.data.number),
              datePublished: String(issue.data.year),
              url: new URL(`/archives/${issue.id}`, Astro.site).toString(),
              isPartOf: {
                '@type': 'PublicationVolume',
                volumeNumber: String(issue.data.volume),
                isPartOf: { '@type': 'Periodical', '@id': `${home}#journal`, name: fullJournalName, ...(site.issnOnline ? { issn: site.issnOnline } : {}) },
              },
            },
          }
        : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: home },
        { '@type': 'ListItem', position: 2, name: 'Archives', item: new URL('/archives', Astro.site).toString() },
        ...(issue ? [{ '@type': 'ListItem', position: 3, name: `Volume ${issue.data.volume}, Issue ${issue.data.number}`, item: new URL(`/archives/${issue.id}`, Astro.site).toString() }] : []),
        { '@type': 'ListItem', position: issue ? 4 : 3, name: article.data.title, item: pageUrl },
      ],
    },
  ],
};
---

<Base title={article.data.title} description={snippet(article.data.abstract, 160)} ogType="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    <meta property="article:published_time" content={isoDate} />
    <meta property="article:section" content={article.data.section} />
    <meta name="citation_title" content={article.data.title} />
    {article.data.authors.map((author, index) => (
      <>
        <meta name="citation_author" content={author} />
        {article.data.affiliations?.[index] && <meta name="citation_author_institution" content={article.data.affiliations[index]} />}
      </>
    ))}
    <meta name="citation_publication_date" content={citationDate} />
    <meta name="citation_journal_title" content={fullJournalName} />
    <meta name="citation_journal_abbrev" content={site.shortTitle} />
    <meta name="citation_publisher" content={site.publisher} />
    {issue && <meta name="citation_volume" content={String(issue.data.volume)} />}
    {issue && <meta name="citation_issue" content={String(issue.data.number)} />}
    {firstPage && <meta name="citation_firstpage" content={firstPage} />}
    {lastPage && <meta name="citation_lastpage" content={lastPage} />}
    {article.data.pdf && <meta name="citation_pdf_url" content={new URL(article.data.pdf, Astro.site).toString()} />}
    <meta name="citation_abstract_html_url" content={pageUrl} />
    <meta name="citation_language" content="en" />
    <meta name="citation_keywords" content={article.data.keywords.join('; ')} />
    {site.issnOnline && <meta name="citation_issn" content={site.issnOnline} />}
    <meta name="DC.title" content={article.data.title} />
    {article.data.authors.map((author) => <meta name="DC.creator" content={author} />)}
  </Fragment>
  <PageHead
    eyebrow={article.data.articleType}
    title={article.data.title}
    crumbs={[
      { label: 'Archives', href: '/archives' },
      ...(issue
        ? [{ label: `Volume ${issue.data.volume}, Issue ${issue.data.number}`, href: `/archives/${issue.id}` }]
        : []),
      { label: 'Article' },
    ]}
  />

  <section class="band">
    <div class="wrap layout-split">
      <article>
        <p class="lede">{article.data.authors.join(', ')}</p>
        {article.data.affiliations && (
          <p class="meta">{article.data.affiliations.join(' · ')}</p>
        )}
        <p class="meta">
          {fullJournalName}
          {issue ? ` · ${issueLabel(issue.data)}` : ''}
          {article.data.pageRange ? ` · Pages ${article.data.pageRange}` : ''}
        </p>

        <div class="abstract">
          <h2>Abstract</h2>
          {abstractParagraphs.map((paragraph) => <p style="margin-bottom:0.8rem">{paragraph}</p>)}
          <p class="meta" style="margin-bottom:0">Keywords: {article.data.keywords.join(', ')}</p>
        </div>

        <div class="prose">
          <Content />
        </div>

        {article.data.references && article.data.references.length > 0 && (
          <section class="prose">
            <h2>References</h2>
            <ul>
              {article.data.references.map((reference) => (
                <li>{reference}</li>
              ))}
            </ul>
          </section>
        )}

        <div class="cite-box" style="margin-top:2.5rem">
          <p class="eyebrow eyebrow-dark">How to cite this article</p>
          <p style="margin-bottom:0">{citation}</p>
        </div>

        <p style="margin-top:1.5rem" class="form-note">
          This article is published under {site.licence}. You may share and adapt it for any purpose, including
          commercially, provided you credit the author and the journal and indicate any changes.
        </p>
      </article>

      <aside class="sidebar">
        <h2>Article record</h2>
        <dl>
          <dt>Type</dt>
          <dd>{article.data.articleType}</dd>
          <dt>Section</dt>
          <dd>{article.data.section}</dd>
          {issue && (
            <>
              <dt>Issue</dt>
              <dd>
                <a href={`/archives/${issue.id}`}>{issueLabel(issue.data)}</a>
              </dd>
            </>
          )}
          {article.data.pageRange && (
            <>
              <dt>Pages</dt>
              <dd>{article.data.pageRange}</dd>
            </>
          )}
          {article.data.receivedDate && (
            <>
              <dt>Received</dt>
              <dd>{article.data.receivedDate}</dd>
            </>
          )}
          {article.data.acceptedDate && (
            <>
              <dt>Accepted</dt>
              <dd>{article.data.acceptedDate}</dd>
            </>
          )}
          {article.data.publishedDate && (
            <>
              <dt>Published</dt>
              <dd>{article.data.publishedDate}</dd>
            </>
          )}
          {article.data.doi && (
            <>
              <dt>DOI</dt>
              <dd><a href={`https://doi.org/${article.data.doi}`}>{article.data.doi}</a></dd>
            </>
          )}
          <dt>Journal</dt>
          <dd>{issnLine()}</dd>
        </dl>
        {article.data.pdf && (
          <p style="margin-top:1.2rem"><a class="btn btn-primary" href={article.data.pdf}>Download PDF</a></p>
        )}
        <p style="margin-top:1rem">
          <a class="btn btn-outline" href={`mailto:${mail('general')}?subject=${encodeURIComponent(`Query about: ${article.data.title}`)}`}>
            Contact the editors
          </a>
        </p>
      </aside>
    </div>
  </section>
</Base>
