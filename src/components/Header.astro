---
import { getCollection } from 'astro:content';
import { byOrder, site, issnLine, submitUrl, submitIsExternal, fullJournalName } from '../lib/site';

const pages = (await getCollection('pages')).sort(byOrder);
const aboutPages = pages.filter((p) => p.data.navGroup === 'About' && p.id !== 'about');
const authorPages = pages.filter((p) => p.data.navGroup === 'For Authors');
const callForPapers = (await getCollection('announcements')).find((a) => a.data.pinned);

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href.replace(/\/$/, '') || '/') === currentPath;
const external = submitIsExternal ? { target: '_blank', rel: 'noopener' } : {};

const menus = [
  {
    label: 'About',
    items: [
      { label: 'About the Journal', href: '/about' },
      { label: 'Editorial Board', href: '/editorial-board' },
      { label: 'Research Sections', href: '/sections' },
      ...aboutPages.map((p) => ({ label: p.data.navLabel, href: `/${p.id}` })),
      { label: 'Announcements', href: '/announcements' },
    ],
  },
  {
    label: 'For Authors',
    items: [
      ...authorPages.map((p) => ({ label: p.data.navLabel, href: `/${p.id}` })),
      { label: 'Submit Online', href: submitUrl },
    ],
  },
];
const links = [
  { label: 'Current Issue', href: '/current' },
  { label: 'Archives', href: '/archives' },
  { label: 'Editorial Board', href: '/editorial-board' },
];
---

<header class="hdr-top" id="site-nav">
  <div class="wrap hdr-top-inner">
    <a class="logo" href="/" aria-label={`${fullJournalName}, home`}>
      <img src="/images/emblem-white.png" alt="" width="32" height="40" />
      <span class="logo-abbr" aria-hidden="true">IRI</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav class="nav" id="main-nav" aria-label="Main">
      <ul class="nav-list">
        <li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Home</a></li>
        <li data-dropdown>
          <button type="button" aria-expanded="false">{menus[0].label}<span class="caret" aria-hidden="true"></span></button>
          <ul class="submenu">
            {menus[0].items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </li>
        {links.map((link) => (
          <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
        <li data-dropdown>
          <button type="button" aria-expanded="false">{menus[1].label}<span class="caret" aria-hidden="true"></span></button>
          <ul class="submenu">
            {menus[1].items.map((item) => (
              <li><a href={item.href} {...(item.href === submitUrl ? external : {})}>{item.label}</a></li>
            ))}
          </ul>
        </li>
        <li><a href="/contact" aria-current={isCurrent('/contact') ? 'page' : undefined}>Contact</a></li>
      </ul>
    </nav>
    <a class="hdr-submit" href={submitUrl} {...external}>Submit Paper</a>
  </div>
</header>

<div class="hdr-title">
  <div class="wrap hdr-title-inner">
    <a class="journal-id" href="/">
      <img src="/images/emblem.png" alt="International Research Insights emblem" width="47" height="58" />
      <span>
        <span class="journal-name">{fullJournalName}</span>
        <span class="journal-meta"><strong>{issnLine()}</strong> · Peer reviewed · Open access · English and Hindi</span>
      </span>
    </a>
    <form class="hdr-search" action="/search" method="get" role="search">
      <label class="sr-only" for="hdr-q">Search the journal</label>
      <input type="search" id="hdr-q" name="q" placeholder="Search title, author, keyword" />
      <button type="submit">Search</button>
    </form>
  </div>
</div>

{site.callForPapersDeadline && (
  <div class="notice" role="note">
    <div class="wrap notice-inner">
      <span><strong>Call for papers:</strong> last date of submission {site.callForPapersDeadline}.</span>
      <a href={submitUrl} {...external}>Submit online</a>
      {callForPapers && <a href={`/announcements/${callForPapers.id}`}>Details</a>}
    </div>
  </div>
)}

<script>
  const nav = document.getElementById('site-nav');
  if (nav) {
    const toggle = nav.querySelector('.nav-toggle');
    const dropdowns = Array.from(nav.querySelectorAll('[data-dropdown]'));

    toggle?.addEventListener('click', () => {
      const open = nav.getAttribute('data-menu') === 'open';
      nav.setAttribute('data-menu', open ? 'closed' : 'open');
      toggle.setAttribute('aria-expanded', String(!open));
    });

    const closeAll = (except) => {
      dropdowns.forEach((item) => {
        if (item === except) return;
        item.setAttribute('data-open', 'false');
        item.querySelector('button')?.setAttribute('aria-expanded', 'false');
      });
    };

    dropdowns.forEach((item) => {
      const button = item.querySelector('button');
      button?.addEventListener('click', (event) => {
        event.preventDefault();
        const open = item.getAttribute('data-open') === 'true';
        closeAll(item);
        item.setAttribute('data-open', String(!open));
        button.setAttribute('aria-expanded', String(!open));
      });
      if (window.matchMedia('(min-width: 1081px) and (hover: hover)').matches) {
        item.addEventListener('mouseenter', () => {
          closeAll(item);
          item.setAttribute('data-open', 'true');
          button?.setAttribute('aria-expanded', 'true');
        });
        item.addEventListener('mouseleave', () => {
          item.setAttribute('data-open', 'false');
          button?.setAttribute('aria-expanded', 'false');
        });
      }
    });

    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target)) closeAll(null);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAll(null);
    });
  }
</script>
