---
import { getCollection } from 'astro:content';
import { byOrder } from '../lib/site';

const pages = (await getCollection('pages')).sort(byOrder);
const sections = (await getCollection('sections')).sort(byOrder);

const aboutPages = pages.filter((p) => p.data.navGroup === 'About');
const authorPages = pages.filter((p) => p.data.navGroup === 'For Authors');
const standalonePages = pages.filter((p) => p.data.navGroup === 'Standalone');

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href.replace(/\/$/, '') || '/') === currentPath;

const groups = [
  {
    label: 'About',
    intro: 'The journal, the people who run it, and the policies that govern every decision it makes.',
    kicker: 'The journal',
    overview: '/about',
    items: [
      { label: 'About the Journal', href: '/about' },
      { label: 'Editorial Board', href: '/editorial-board' },
      ...aboutPages.filter((p) => p.id !== 'about').map((p) => ({ label: p.data.navLabel, href: `/${p.id}` })),
      ...standalonePages.filter((p) => p.id !== 'contact').map((p) => ({ label: p.data.navLabel, href: `/${p.id}` })),
    ],
  },
  {
    label: 'Research',
    intro: 'Seven research sections, one standard of review: evidence first, written for readers who decide.',
    kicker: 'Research sections',
    overview: '/sections',
    items: sections.map((s) => ({ label: s.data.title, href: `/sections/${s.id}` })),
  },
  {
    label: 'Publications',
    intro: 'Every issue and every article, free to read, with full citation details and PDFs.',
    kicker: 'Issues and articles',
    overview: '/archives',
    items: [
      { label: 'Current Issue', href: '/current' },
      { label: 'Archives', href: '/archives' },
      { label: 'Announcements', href: '/announcements' },
      { label: 'Search the Journal', href: '/search' },
    ],
  },
  {
    label: 'For Authors',
    intro: 'What to send, how review works, what it costs after acceptance, and what happens next.',
    kicker: 'Submitting your work',
    overview: '/submission-guidelines',
    items: authorPages.map((p) => ({ label: p.data.navLabel, href: `/${p.id}` })),
  },
];
---

<nav class="nav" id="site-nav" aria-label="Main">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="International Research Insights: Multidisciplinary e-Journal, home">
      <img src="/images/emblem-white.png" alt="" width="40" height="50" />
      <span class="brand-text"><span class="brand-name">International Research Insights</span><span class="brand-sub">Multidisciplinary e-Journal</span></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-collapse">Menu</button>
    <div class="nav-collapse" id="nav-collapse">
      <ul class="nav-list">
        {groups.map((group) => (
          <li data-dropdown>
            <button type="button" aria-expanded="false">
              {group.label}<span class="caret" aria-hidden="true"></span>
            </button>
            <div class="submenu mega">
              <div class="mega-intro">
                <p class="mega-title">{group.label}</p>
                <p>{group.intro}</p>
                <a class="more-link" href={group.overview}>Overview</a>
              </div>
              <div class="mega-list">
                <p class="mega-kicker">{group.kicker}</p>
                <ol>
                  {group.items.map((item, index) => (
                    <li><a href={item.href}><span class="num">{String(index + 1).padStart(2, '0')}</span>{item.label}</a></li>
                  ))}
                </ol>
              </div>
            </div>
          </li>
        ))}
        {standalonePages.filter((p) => p.id === 'contact').map((p) => (
          <li><a href={`/${p.id}`} aria-current={isCurrent(`/${p.id}`) ? 'page' : undefined}>{p.data.navLabel}</a></li>
        ))}
      </ul>
      <a class="nav-search" href="/search" aria-label="Search the journal">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      </a>
      <a class="nav-cta" href="/submission-guidelines">Submit</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-nav');
  if (nav) {
    const toggle = nav.querySelector('.nav-toggle');
    const dropdowns = Array.from(nav.querySelectorAll('[data-dropdown]'));

    toggle?.addEventListener('click', () => {
      const open = nav.getAttribute('data-menu') === 'open';
      nav.setAttribute('data-menu', open ? 'closed' : 'open');
      toggle.setAttribute('aria-expanded', String(!open));
    });

    const closeAll = (except) => {
      dropdowns.forEach((item) => {
        if (item === except) return;
        item.setAttribute('data-open', 'false');
        item.querySelector('button')?.setAttribute('aria-expanded', 'false');
      });
    };

    dropdowns.forEach((item) => {
      const button = item.querySelector('button');
      button?.addEventListener('click', (event) => {
        event.preventDefault();
        const open = item.getAttribute('data-open') === 'true';
        closeAll(item);
        item.setAttribute('data-open', String(!open));
        button.setAttribute('aria-expanded', String(!open));
      });

      if (window.matchMedia('(min-width: 1241px)').matches) {
        item.addEventListener('mouseenter', () => {
          closeAll(item);
          item.setAttribute('data-open', 'true');
          button?.setAttribute('aria-expanded', 'true');
        });
        item.addEventListener('mouseleave', () => {
          item.setAttribute('data-open', 'false');
          button?.setAttribute('aria-expanded', 'false');
        });
      }
    });

    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target)) closeAll(null);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAll(null);
    });
  }
</script>
