---
interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
  crumbs?: { label: string; href?: string }[];
  /** Set false where the page writes its own breadcrumb structured data. */
  crumbsLd?: boolean;
}
const { title, lede, eyebrow, crumbs = [], crumbsLd = true } = Astro.props;
const origin = Astro.site ?? new URL('https://internationalresearchinsights.com');
const here = new URL(Astro.url.pathname, origin).toString();
const trail = [{ label: 'Home', href: '/' }, ...crumbs];
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: i === trail.length - 1 && !c.href ? title : c.label,
    item: c.href ? new URL(c.href, origin).toString() : here,
  })),
};
---

{crumbsLd && crumbs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
<section class="page-head">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        {crumbs.map((crumb) => (
          <>
            {' / '}
            {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
          </>
        ))}
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
  </div>
</section>
