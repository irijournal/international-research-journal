---
import { render } from 'astro:content';
import { site, mail, issueLabel } from '../lib/site';

const { issue, articles } = Astro.props;
const { Content } = await render(issue);
---

<section class="band">
  <div class="wrap layout-split">
    <div>
      <p class="eyebrow">Editorial note</p>
      <h2>{issue.data.editorialTitle}</h2>
      <p class="meta" style="margin-bottom:1.5rem">{issue.data.editorialAuthor}</p>
      <div class="prose">
        <Content />
      </div>

      <h2 style="margin-top:3rem">Contents</h2>
      {articles.length > 0 ? (
        <table class="index-table">
          <thead>
            <tr><th>S.No.</th><th>Title and author(s)</th><th>Section / type</th><th>Pages</th><th>PDF</th></tr>
          </thead>
          <tbody>
            {articles.map((article, index) => (
              <tr>
                <td data-label="S.No.">{String(index + 1).padStart(2, '0')}</td>
                <td data-label="Title">
                  <a class="index-title" href={`/articles/${article.id}`}>{article.data.title}</a>
                  <span class="index-authors">{article.data.authors.join(', ')}</span>
                </td>
                <td data-label="Section">{article.data.section}<br /><em>{article.data.articleType}</em></td>
                <td data-label="Pages">{article.data.pageRange ?? ''}</td>
                <td data-label="PDF">{article.data.pdf && <a href={article.data.pdf}>Download</a>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <div class="cite-box">
          <p style="margin-bottom:0.6rem">
            <strong>This issue is open for submissions.</strong>
          </p>
          <p style="margin-bottom:0.6rem">
            The table of contents is published as soon as manuscripts complete double anonymous review. Accepted
            articles appear here in the order fixed by the editorial board.
          </p>
          <p style="margin-bottom:0">
            To be considered, read the <a href="/submission-guidelines">submission guidelines</a> and send your
            manuscript to <a href={`mailto:${mail('submissions')}`}>{mail('submissions')}</a>.
          </p>
        </div>
      )}
    </div>

    <aside class="sidebar">
      {issue.data.cover && (
        <img class="issue-cover" src={issue.data.cover} alt={`Cover of ${issueLabel(issue.data)}`} />
      )}
      <h2>Issue details</h2>
      <dl>
        <dt>Volume and issue</dt>
        <dd>Volume {issue.data.volume}, Issue {issue.data.number}</dd>
        {issue.data.month && (
          <>
            <dt>Month and year</dt>
            <dd>{issue.data.month} {issue.data.year}</dd>
          </>
        )}
        <dt>Period covered</dt>
        <dd>{issue.data.period} {issue.data.year}</dd>
        <dt>Status</dt>
        <dd>{issue.data.status}</dd>
        {issue.data.submissionDeadline && (
          <>
            <dt>Submission deadline</dt>
            <dd>{issue.data.submissionDeadline}</dd>
          </>
        )}
        {issue.data.publicationDate && (
          <>
            <dt>Published online</dt>
            <dd>{issue.data.publicationDate}</dd>
          </>
        )}
        <dt>Licence</dt>
        <dd>{site.licence}</dd>
        <dt>Articles listed</dt>
        <dd>{articles.length}</dd>
      </dl>
      <p style="margin-top:1.2rem">
        <a class="btn btn-outline" href="/submission-guidelines">Submission guidelines</a>
      </p>
    </aside>
  </div>
</section>
